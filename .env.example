# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="NWEF Online Application Portal"

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://nwef:nwef@localhost:5432/nwef?schema=public"

# ── Security ────────────────────────────────────────────────────────────────
# 32+ random characters. Generate: openssl rand -base64 48
OTP_SECRET="replace-with-a-long-random-otp-secret"
SESSION_SECRET="replace-with-a-different-long-random-session-secret"
AUDIT_SECRET="replace-with-a-third-long-random-audit-secret"
# Base64-encoded 32-byte key. Generate: openssl rand -base64 32
PDPA_ENCRYPTION_KEY="replace-with-base64-32-byte-key"

# ── Object storage (local | s3) ─────────────────────────────────────────────
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
S3_BUCKET=nwef-documents
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── OTP delivery (console | twilio) ─────────────────────────────────────────
# console prints the code in runtime logs; twilio sends a real SMS.
OTP_DRIVER=console
# Twilio trial accounts can only SMS verified recipient numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Business rules ──────────────────────────────────────────────────────────
SCREENING_TURNAVEROUND_DAYS=10
SLA_WARNING_DAYS=2
MIN_PANEL_SCORE_FOR_RECOMMENDATION=3.5
CURRENCY=LKR

# ── PDF award letter ────────────────────────────────────────────────────────
AWARD_LETTER_LOGO_PATH=
AWARD_SIGNATORY_NAME="Chairman, NWEF Trust Board"
